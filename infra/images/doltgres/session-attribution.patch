+// pgStatSessionAttribution holds a snapshot from the actual session, not the
+// ProcessList's cached startup identity. Preserve the exact database string:
+// revision-qualified databases must not be silently attributed to another base.
+// This is not an atomic snapshot with ProcessList; unmatched rows remain unknown.
+type pgStatSessionAttribution struct {
+	database string
+	user     string
+}
+
+func readPgStatSessionAttribution(iterate func(func(sql.Session) (bool, error)) error) map[uint32]pgStatSessionAttribution {
+	if iterate == nil {
+		return nil
+	}
+	result := make(map[uint32]pgStatSessionAttribution)
+	ambiguous := make(map[uint32]bool)
+	err := iterate(func(session sql.Session) (bool, error) {
+		if session == nil {
+			return false, nil
+		}
+		connection := session.ID()
+		if _, exists := result[connection]; exists || ambiguous[connection] {
+			delete(result, connection)
+			ambiguous[connection] = true
+			return false, nil
+		}
+		result[connection] = pgStatSessionAttribution{
+			database: session.GetCurrentDatabase(),
+			user:     session.Client().User,
+		}
+		return false, nil
+	})
+	if err != nil {
+		// Do not publish a partial session census as known attribution.
+		return nil
+	}
+	return result
+}
+
