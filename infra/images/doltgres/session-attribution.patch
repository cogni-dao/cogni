diff --git a/server/doltgres_handler_max1_test.go b/server/doltgres_handler_max1_test.go
new file mode 100644
index 0000000..cc91d03
--- /dev/null
+++ b/server/doltgres_handler_max1_test.go
@@ -0,0 +1,165 @@
+// Copyright 2026 Dolthub, Inc.
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+
+package server
+
+import (
+	"context"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/dolthub/go-mysql-server/sql"
+	"github.com/dolthub/go-mysql-server/sql/types"
+	"github.com/dolthub/vitess/go/sqltypes"
+)
+
+type max1LazyString struct {
+	value     string
+	failure   error
+	unwrapped bool
+}
+
+func (v *max1LazyString) Unwrap(ctx context.Context) (string, error) {
+	v.unwrapped = true
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	return v.value, v.failure
+}
+func (v *max1LazyString) UnwrapAny(ctx context.Context) (interface{}, error) { return v.Unwrap(ctx) }
+func (v *max1LazyString) IsExactLength() bool                                { return false }
+func (v *max1LazyString) MaxByteLength() int64                               { return 1 << 30 }
+func (v *max1LazyString) Compare(context.Context, interface{}) (int, bool, error) {
+	return 0, false, nil
+}
+func (v *max1LazyString) Hash() interface{} { return v }
+
+var _ sql.StringWrapper = (*max1LazyString)(nil)
+
+// Exercise rowToBytes' real text SQL conversion boundary without a global
+// function registry or server. The lazy wrapper sees the original query ctx.
+type max1TextType struct{ sql.Type }
+
+func (t max1TextType) SQL(ctx *sql.Context, _ []byte, value interface{}) (sqltypes.Value, error) {
+	text, ok, err := sql.Unwrap[string](ctx, value)
+	if err != nil {
+		return sqltypes.Value{}, err
+	}
+	if !ok {
+		return sqltypes.Value{}, errors.New("test value is not a string wrapper")
+	}
+	return sqltypes.MakeTrusted(sqltypes.Text, []byte(text)), nil
+}
+
+type max1Iter struct {
+	rows                  []sql.Row
+	nextCalls, closeCalls int
+	nextErrorAt           int
+	nextError, closeError error
+	cancel                context.CancelFunc
+	cancelOnEOF           bool
+}
+
+func (i *max1Iter) Next(*sql.Context) (sql.Row, error) {
+	i.nextCalls++
+	if i.nextCalls == i.nextErrorAt {
+		return nil, i.nextError
+	}
+	if i.nextCalls > len(i.rows) {
+		if i.cancelOnEOF {
+			i.cancel()
+		}
+		return nil, io.EOF
+	}
+	return i.rows[i.nextCalls-1], nil
+}
+func (i *max1Iter) Close(*sql.Context) error {
+	i.closeCalls++
+	i.cancel()
+	return i.closeError
+}
+
+func TestMax1RowMaterializesLazyValueBeforeCancellation(t *testing.T) {
+	for _, eofCancels := range []bool{false, true} {
+		name := "close cancels"
+		if eofCancels {
+			name = "EOF cancels"
+		}
+		t.Run(name, func(t *testing.T) {
+			parent, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			ctx := sql.NewContext(parent)
+			value := &max1LazyString{value: "cold out-of-band text"}
+			iter := &max1Iter{rows: []sql.Row{{value}}, cancel: cancel, cancelOnEOF: eofCancels}
+			schema := sql.Schema{&sql.Column{Name: "payload", Type: max1TextType{types.LongText}}}
+			got, err := resultForMax1RowIter(ctx, schema, iter, nil, []int16{0})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !value.unwrapped || len(got.Rows) != 1 || string(got.Rows[0].val[0]) != value.value {
+				t.Fatalf("lazy payload lost: %#v", got)
+			}
+			if iter.closeCalls != 1 || iter.nextCalls != 2 || ctx.Err() != context.Canceled {
+				t.Fatalf("lifecycle: %#v, ctx=%v", iter, ctx.Err())
+			}
+		})
+	}
+}
+
+func TestMax1RowClosesOnceAndPreservesErrors(t *testing.T) {
+	nextFailure := errors.New("native Next failed")
+	convertFailure := errors.New("lazy conversion failed")
+	closeFailure := errors.New("native Close failed")
+	for _, tc := range []struct {
+		name                          string
+		rows                          int
+		nextAt                        int
+		nextErr, convertErr, closeErr error
+		cancelFirst                   bool
+		want                          error
+		cardinality                   bool
+	}{
+		{name: "empty"},
+		{name: "empty close error", closeErr: closeFailure, want: closeFailure},
+		{name: "first Next error", nextAt: 1, nextErr: nextFailure, want: nextFailure},
+		{name: "second Next error", rows: 1, nextAt: 2, nextErr: nextFailure, want: nextFailure},
+		{name: "more than one row", rows: 2, cardinality: true},
+		{name: "serialization error", rows: 1, convertErr: convertFailure, want: convertFailure},
+		{name: "serialization wins over Close error", rows: 1, convertErr: convertFailure, closeErr: closeFailure, want: convertFailure},
+		{name: "successful serialization Close error", rows: 1, closeErr: closeFailure, want: closeFailure},
+		{name: "parent already cancelled", rows: 1, cancelFirst: true, want: context.Canceled},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			parent, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if tc.cancelFirst {
+				cancel()
+			}
+			value := &max1LazyString{value: "payload", failure: tc.convertErr}
+			iter := &max1Iter{cancel: cancel, nextErrorAt: tc.nextAt, nextError: tc.nextErr, closeError: tc.closeErr}
+			for j := 0; j < tc.rows; j++ {
+				iter.rows = append(iter.rows, sql.Row{value})
+			}
+			schema := sql.Schema{&sql.Column{Name: "payload", Type: max1TextType{types.LongText}}}
+			got, err := resultForMax1RowIter(sql.NewContext(parent), schema, iter, nil, []int16{0})
+			if tc.cardinality {
+				if err == nil || err.Error() != "result max1Row iterator returned more than one row" {
+					t.Fatalf("wrong cardinality error: %v", err)
+				}
+			} else if !errors.Is(err, tc.want) {
+				t.Fatalf("got %v, want %v", err, tc.want)
+			}
+			if tc.want != nil || tc.cardinality {
+				if got != nil {
+					t.Fatalf("error exposed result: %#v", got)
+				}
+			}
+			if iter.closeCalls != 1 {
+				t.Fatalf("Close called %d times", iter.closeCalls)
+			}
+		})
+	}
+}
