//
// Kubernetes Event collection for k3s-backed candidate/preview/production VMs.
// Runs in a separate host-network Alloy container so the mounted k3s kubeconfig
// can reach its default https://127.0.0.1:6443 API server without changing the
// main Alloy container's compose-network app and worker scrapes.

loki.source.kubernetes_events "events" {
  job_name   = "kubernetes-events"
  log_format = "json"
  namespaces = [
    "argocd",
    "kube-system",
    // bug.5011: the secret plane (OpenBao + ESO) was invisible to Loki, so the
    // prod OpenBao OOMKill→reseal outage was silent. Watch these so an OpenBao
    // OOMKilled/restart event reaches Loki and a sealed-state alert can fire.
    "openbao",
    "external-secrets",
    // bug.5219: the Crossplane runtime (provider-http, functions) is the actuator's
    // wire path; its events were invisible while a lease-create POST silently
    // never arrived.
    "crossplane-system",
    // bug.5416: events whose involved object is CLUSTER-SCOPED carry no namespace of
    // their own, so client-go's makeEvent files them under `default` — they never appear
    // in crossplane-system. That silently hid the entire cluster-scoped plane:
    // CompositionRevision/Composition/XRD, Provider + Function (and their Revisions),
    // ClusterProviderConfig, plus kubelet's Node events (NodeNotReady, *Pressure).
    // Observed: `CompositionRevision/xcomputeworkload-akash-8c6fb2f` emitting into
    // `default` while namespace="default" was absent from this list, so it was dropped.
    // Nothing in infra/ or nodes/ deploys INTO `default`, so this watch adds only
    // cluster-scoped-object events, not workload chatter. Kept whole rather than
    // kind-filtered on purpose: bug.5011 (openbao/ESO) and bug.5219 (crossplane-system)
    // were both "the gate was too narrow" outages, and a kind allowlist here would
    // pre-decide which cluster-scoped failure we are allowed to see next.
    "default",
    "cogni-candidate-a",
    "cogni-preview",
    "cogni-production",
  ]

  client {
    kubeconfig_file = "/etc/rancher/k3s/k3s.yaml"
  }

  forward_to = [loki.process.k8s_events.receiver]
}

loki.process "k8s_events" {
  stage.json {
    expressions = {
      event_type = "type",
      kind       = "kind",
      reason     = "reason",
    }
  }

  stage.labels {
    values = {
      event_type = "",
      kind       = "",
      reason     = "",
    }
  }

  stage.static_labels {
    values = {
      app     = "cogni-template",
      env     = sys.env("DEPLOY_ENVIRONMENT"),
      service = "kubernetes-events",
      source  = "k8s-events",
    }
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")

    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}
