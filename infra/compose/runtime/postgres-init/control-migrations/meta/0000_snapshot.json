          "value": "(\"cogni_control\".\"database_recoveries\".\"started_at\" IS NULL AND \"cogni_control\".\"database_recoveries\".\"deadline_at\" IS NULL) OR \"cogni_control\".\"database_recoveries\".\"deadline_at\" = \"cogni_control\".\"database_recoveries\".\"started_at\" + interval '10 minutes'"
