      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "node_slug" }]
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min by (environment, node_slug) (min_over_time(probe_success{environment=~\"candidate-a|preview|production\",proof_class=\"serve\"}[5m]))",
          "instant": true,
          "legendFormat": "{{environment}} · {{node_slug}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current node state",
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "environment": 0, "node_slug": 1, "Value": 2 },
            "renameByName": {
              "Value": "state",
              "environment": "environment",
              "node_slug": "node"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "decimals": 3,
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (environment, node_slug) (probe_duration_seconds{environment=~\"candidate-a|preview|production\",proof_class=\"serve\"})",
          "instant": false,
          "legendFormat": "{{environment}} · {{node_slug}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Endpoint latency by node",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "asc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * avg by (environment, node_slug) (avg_over_time(probe_success{environment=~\"candidate-a|preview|production\",proof_class=\"serve\"}[5m]))",
          "instant": false,
          "legendFormat": "{{environment}} · {{node_slug}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Rolling availability",
      "type": "timeseries"
