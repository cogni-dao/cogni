apiVersion: v1
data:
  COGNI_NODE_ENDPOINTS: beacon=https://beacon.cognidao.org,f97f68f2-8406-4a3b-b5a9-d579b779f19d=https://beacon.cognidao.org,levelup=https://levelup.cognidao.org,557d8b59-8e3b-42f0-9aeb-a5c171296556=https://levelup.cognidao.org,node-template=https://node-template.cognidao.org,b927a9dd-6132-4fc9-a51e-e3cee2568e3c=https://node-template.cognidao.org,operator=http://operator-node-app:3000,4ff8eac1-4eba-4ed0-931b-b1fe4f64713d=http://operator-node-app:3000,poly=https://poly.cognidao.org,4b06359a-a859-4399-888e-a8c7a6696f7e=https://poly.cognidao.org,red=https://red.cognidao.org,921b1d1d-4ded-4a6d-b3f1-f7d6affa406a=https://red.cognidao.org,toks5=https://toks5.cognidao.org,f66b260b-4633-41e2-8711-b7c1b8449cc1=https://toks5.cognidao.org
  DEPLOY_ENVIRONMENT: production
  HEALTH_PORT: "9000"
  IMAGE_DIGEST: sha256:e5bf82ad88974c539d11479671c503d4b082f6ecb48c02f843828264a6679cfc
  LOG_LEVEL: info
  SERVICE_NAME: scheduler-worker
  TEMPORAL_ADDRESS: temporal:7233
  TEMPORAL_CUSTODIED_NAMESPACES: cogni-candidate-a,cogni-preview
