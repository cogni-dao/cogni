  TEMPORAL_TASK_QUEUE: scheduler-tasks
kind: ConfigMap
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: scheduler-worker
    app.kubernetes.io/part-of: cogni
  name: scheduler-worker-config
  namespace: cogni-production
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
  name: app
  namespace: cogni-production
spec:
  externalName: cogni.vm.cognidao.org
  ports:
  - name: http
    port: 3000
    protocol: TCP
  type: ExternalName
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
  name: postgres
  namespace: cogni-production
spec:
  externalName: cogni.vm.cognidao.org
  ports:
  - name: postgres
    port: 5432
    protocol: TCP
  type: ExternalName
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: scheduler-worker
    app.kubernetes.io/part-of: cogni
  name: scheduler-worker
  namespace: cogni-production
spec:
  ports:
  - name: health
    nodePort: 30900
    port: 9000
    protocol: TCP
    targetPort: health
  selector:
    app.kubernetes.io/name: scheduler-worker
  type: NodePort
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
  name: temporal
  namespace: cogni-production
spec:
  externalName: cogni.vm.cognidao.org
  ports:
  - name: grpc
    port: 7233
    protocol: TCP
  type: ExternalName
---
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    reloader.stakater.com/auto: "true"
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: scheduler-worker
    app.kubernetes.io/part-of: cogni
  name: scheduler-worker
  namespace: cogni-production
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: scheduler-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: scheduler-worker
        app.kubernetes.io/part-of: cogni
    spec:
      containers:
      - envFrom:
        - secretRef:
            name: scheduler-worker-secrets
        - configMapRef:
            name: scheduler-worker-config
        image: ghcr.io/cogni-dao/cogni-template@sha256:e5bf82ad88974c539d11479671c503d4b082f6ecb48c02f843828264a6679cfc
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /livez
            port: health
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 2
        name: scheduler-worker
        ports:
        - containerPort: 9000
          name: health
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /readyz
            port: health
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 2
        resources:
          limits:
            cpu: "2"
            memory: 1Gi
          requests:
            cpu: 250m
            memory: 256Mi
        startupProbe:
          failureThreshold: 60
          httpGet:
            path: /livez
            port: health
          periodSeconds: 5
          timeoutSeconds: 2
      terminationGracePeriodSeconds: 30
