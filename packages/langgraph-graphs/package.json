{
  "name": "@cogni/langgraph-graphs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./graphs": {
      "types": "./dist/graphs/index.d.ts",
      "import": "./dist/graphs/index.js",
      "default": "./dist/graphs/index.js"
    },
    "./inproc": {
      "types": "./dist/inproc/index.d.ts",
      "import": "./dist/inproc/index.js",
      "default": "./dist/inproc/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')){console.error('ERROR: dist/index.js missing'); process.exit(1)}\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ci": "vitest run --config vitest.config.ts",
    "test:external": "vitest run --config vitest.external.config.ts"
  },
  "dependencies": {
    "@cogni/ai-core": "workspace:*",
    "@cogni/ai-tools": "workspace:*",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.10",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "1.6.2",
    "langchain": "1.5.10",
    "zod": "^3.24.1",
    "deepagents": "1.16.0",
    "@langchain/anthropic": "1.5.12",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-sdk": "1.9.29",
    "langsmith": "0.9.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
